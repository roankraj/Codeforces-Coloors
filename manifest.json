{
  "manifest_version": 3,
  "version": "1.0",
  "name": "codeforces minimal dake mode",
  "description": "chrome web extension to make codeforces pages dark",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "64": "icon-64.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://codeforces.com/*"],
      "css": ["css/styles.css"],
      "js": ["js/content.js"],
      "run_at": "document_start"
    }
  ]
}
